#!/bin/bash

echo "🚀 プッシュ前の最終チェック中..."

# 全体ビルド確認
echo "📦 ビルド確認中..."
mvn clean compile -q

if [ $? -ne 0 ]; then
    echo "❌ ビルドが失敗しました。プッシュを中止します。"
    exit 1
fi

# 全テスト実行
echo "🧪 全テスト実行中..."
mvn test -q

if [ $? -ne 0 ]; then
    echo "❌ テストが失敗しました。プッシュを中止します。"
    exit 1
fi

echo "✅ 全てのチェックが成功しました。プッシュを続行します。"